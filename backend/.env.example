PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/biznotify

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_key
JWT_EXPIRES_IN=7d

# Termii
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=your_sender_id_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Default country code for phone normalization (e.g. 234 for Nigeria)
DEFAULT_COUNTRY_CODE=234
