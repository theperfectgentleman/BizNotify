# ══════════════════════════════════════════════════════════════
#  BizNotify — Production Environment Variables
#  Paste these into Dokploy → Environment tab
#  DO NOT commit this file with real values
# ══════════════════════════════════════════════════════════════

# ── External Database ──────────────────────────────────────────
# Your existing PostgreSQL connection string
DATABASE_URL=postgresql://user:password@your-host:5432/biznotdb

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=7d

# ── Termii API ─────────────────────────────────────────────────
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=your_sender_id_here

# ── App Config ─────────────────────────────────────────────────
DEFAULT_COUNTRY_CODE=234
DEFAULT_ADMIN_EMAIL=admin@biznotify.com
DEFAULT_ADMIN_PASSWORD=change_this_after_first_login

# ── CORS ───────────────────────────────────────────────────────
# Your Dokploy domain, e.g. https://biznotify.yourdomain.com
FRONTEND_URL=https://yourdomain.com
